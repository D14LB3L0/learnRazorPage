@page
@using razorPage.Models
@model razorPage.Pages.BookModel
@{
	<h1>Books page</h1>

	<form method="post">
		<input type="number" name="id" />
		<input type="text" name="title" />
		<input type="text" name="description" />
		<input type="text" name="author" />

		<button type="submit">Add</button>
	</form>

	<table>
		<thead>
			<tr>
				<th>Id</th>
				<th>Title</th>
				<th>Description</th>
				<th>Author</th>
			</tr>
		</thead>

		<tbody>
			@foreach (Book book in Model.Books)
			{
				<tr id="row-@book.Id">
					<td>@book.Id</td>

					<td>
						<span class="display">@book.Title</span>
						<input class="edit-input d-none" name="title" value="@book.Title" />
					</td>

					<td>
						<span class="display">@book.Description</span>
						<input class="edit-input d-none" name="description" value="@book.Description" />
					</td>
					
					<td>
						<span class="display">@book.Author</span>
						<input class="edit-input d-none" name="author" value="@book.Author" />
					</td>

					<td>
						<button type="button" onclick="enableEdit(@book.Id)">Editar</button>
						<button type="button" class="d-none" onclick="confirmEdit(@book.Id)">Confirmar</button>
						<button type="button" class="d-none" onclick="cancelEdit(@book.Id)">Cancelar</button>
					</td>

					<td>
						<form method="post" asp-page-handler="Delete">
							@Html.AntiForgeryToken()
							<input type="hidden" name="id" value="@book.Id" />
							<button type="submit">Eliminar</button>
						</form>
					</td>

				</tr>
			}
		</tbody>
	</table>
}

@section Scripts {
	<script src="~/js/books.js" asp-append-version="true"></script>
}
